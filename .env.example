# Copy this file to .env and fill in your real values.

# Azure AI Document Intelligence
# Portal -> your Document Intelligence resource -> Keys and Endpoint
AZURE_DI_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/
AZURE_DI_KEY=

# Sign-in gate. Both are required: with either unset, nobody can sign in.
# This is a demo gate, not an identity system.
APP_USERNAME=
APP_PASSWORD=

# Optional. Signs the session cookie. If unset it is derived from the
# password, so changing the password invalidates existing sessions.
AUTH_SECRET=
